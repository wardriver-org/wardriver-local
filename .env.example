# Wardriver Local
WARDIVER_PORT=8787

# Default local basemap settings for a fresh SQLite database.
WARDIVER_BASEMAP_PROVIDER=none
WARDIVER_BASEMAP_URL=/maps/region.pmtiles
WARDIVER_BASEMAP_ATTRIBUTION=© OpenStreetMap contributors · Protomaps
WARDIVER_BASEMAP_CACHE_ALLOWED=0

# One-time regional map extraction defaults.
# Set your own west,south,east,north bounds before downloading a map.
WARDIVER_MAP_SOURCE=https://build.protomaps.com/20260722.pmtiles
WARDIVER_MAP_BBOX=
WARDIVER_MAP_MAXZOOM=15
WARDIVER_MAP_DOWNLOAD_THREADS=8

# Optional routing/geocoding services.
WARDIVER_GEOCODER_URL=https://nominatim.openstreetmap.org
WARDIVER_ROUTER_URL=https://router.project-osrm.org

# Bounded local API worker pool (2-32). 8 is a good default.
WARDIVER_HTTP_WORKERS=8

# Flock photo evidence uploads (bytes; default 10 MiB)
WARDIVER_FLOCK_PHOTO_MAX_BYTES=10485760

# Flock external verification (manual checks only)
WARDIVER_FLOCK_VERIFY_RADIUS_M=250
WARDIVER_FLOCK_VERIFY_CACHE_HOURS=168
WARDIVER_FLOCK_VERIFY_TIMEOUT=12
# Comma-separated public Overpass endpoints.
WARDIVER_OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
WARDIVER_EFF_ATLAS_URL=https://atlasofsurveillance.org

# In-app regional downloads (stored in the existing /data volume).
WARDIVER_MAP_AREA_MAX_GB=20
WARDIVER_MAP_AREA_TIMEOUT=21600
